{
  "name": "josepaulotimbang/portfolio-api",
  "description": "Portfolio REST API — CodeIgniter 4",
  "type": "project",
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7",
    "firebase/php-jwt": "^7.0",
    "maxmind-db/reader": "^1.12"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
