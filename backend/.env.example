CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = portfolio_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Admin login. ADMIN_PASSWORD is a hash, never the plain password:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_EMAIL = admin@josepaulotimbang.com
ADMIN_PASSWORD =

# Random strings, 32+ characters each:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET =
JWT_TTL = 28800
# Shared with the chatbot (Render) and the job finder (GitHub secret)
INGEST_KEY =

# Only needed for local development of the admin page
CORS_ORIGINS = http://localhost:3000

# Admin "Analytics & SEO" tab (optional). Upload the Google Cloud service account
# JSON key to writable/google/service-account.json (or set GOOGLE_CREDENTIALS_FILE),
# then give that service account's email Viewer access in GA4 and a user in Search Console.
GA_PROPERTY_ID =
SEARCH_CONSOLE_SITE = sc-domain:josepaulotimbang.com
