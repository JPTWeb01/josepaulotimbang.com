# Copy to .env.local and fill in values

# API base URL (no trailing slash)
# Local dev:   http://localhost:8000/v1
# Production:  https://api.josepaulotimbang.com/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# Google Analytics 4 Measurement ID (public). Overrides the default in lib/analytics.ts
# (set to a test ID for local testing).
NEXT_PUBLIC_GA_ID=

# Admin dashboard API (local dev only; production uses /api/v1)
NEXT_PUBLIC_ADMIN_API_URL=
